# Example environment file

# Copy this file to `.env` and populate values needed for local development.
# Do NOT commit `.env` to version control.

# Example values (placeholders)
DATABASE_URL=postgresql://user:password@localhost:5432/fablit_db
SECRET_KEY=changeme
PYPI_API_TOKEN=replace_with_token_for_testing_only

# Fablit configuration and logging
FABLIT_CONFIG=./config.json
FABLIT_SERVICE_NAME=fablit
FABLIT_ENV=development
FABLIT_VERSION=0.1.0
FABLIT_HOST=0.0.0.0
FABLIT_PORT=8000
FABLIT_DEBUG=false
FABLIT_LOG_LEVEL=INFO
FABLIT_LOG_FORMAT=json
# Visual stimulus provider: builtin (deterministic bundled stimuli) or wikimedia (approved external source with safe fallback)
FABLIT_STIMULUS_PROVIDER=builtin
